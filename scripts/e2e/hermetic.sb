(version 1)
(allow default)
(allow process*)
(allow process-exec (literal "/bin/ps"))
(allow process-exec (literal "/usr/bin/ps"))
(allow file-read* (literal "/bin/ps"))
(allow file-read* (literal "/usr/bin/ps"))
(allow file-read* (literal "/usr/lib/libproc.dylib"))
(allow file-read* (subpath "/System/Library/Frameworks"))
(allow sysctl-read)
(deny network-outbound)
(allow network-outbound (remote ip "localhost:*"))
(allow network-inbound (local ip "localhost:*"))
