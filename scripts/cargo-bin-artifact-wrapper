#!/usr/bin/env bash
set -euo pipefail

if [ "$#" -lt 1 ]; then
  echo "usage: cargo-bin-artifact-wrapper <rustc> [rustc-args...]" >&2
  exit 2
fi

rustc="$1"
shift
args=("$@")

repo="${CARGO_BIN_ARTIFACT_REPO:-}"
if [ -z "$repo" ]; then
  repo="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
fi

legacy_prefix="${CARGO_BIN_ARTIFACT_LEGACY_PREFIX:-}"

legacy_value() {
  local suffix="$1"
  local var
  if [ -z "$legacy_prefix" ]; then
    return 1
  fi
  var="${legacy_prefix}_${suffix}"
  printf '%s' "${!var:-}"
}

if [ "$rustc" = "rustc" ] && command -v rustup >/dev/null 2>&1; then
  rustc="$(cd "$repo" && rustup which rustc 2>/dev/null || printf '%s' "$rustc")"
fi

crate_name=""
crate_type=""
out=""
out_dir=""
extra_filename=""
is_test=0

i=0
while [ "$i" -lt "${#args[@]}" ]; do
  arg="${args[$i]}"
  case "$arg" in
    --crate-name)
      i=$((i + 1))
      crate_name="${args[$i]:-}"
      ;;
    --crate-name=*)
      crate_name="${arg#--crate-name=}"
      ;;
    --crate-type)
      i=$((i + 1))
      crate_type="${args[$i]:-}"
      ;;
    --crate-type=*)
      crate_type="${arg#--crate-type=}"
      ;;
    -o)
      i=$((i + 1))
      out="${args[$i]:-}"
      ;;
    --out-dir)
      i=$((i + 1))
      out_dir="${args[$i]:-}"
      ;;
    -C)
      i=$((i + 1))
      codegen_opt="${args[$i]:-}"
      case "$codegen_opt" in
        extra-filename=*) extra_filename="${codegen_opt#extra-filename=}" ;;
      esac
      ;;
    -Cextra-filename=*)
      extra_filename="${arg#-Cextra-filename=}"
      ;;
    --test)
      is_test=1
      ;;
  esac
  i=$((i + 1))
done

delegate_override="${CARGO_BIN_ARTIFACT_WRAPPER_DELEGATE:-$(legacy_value DELEGATE || true)}"
no_cache="${CARGO_BIN_ARTIFACT_WRAPPER_NO_CACHE:-$(legacy_value NO_KACHE || true)}"
no_cache="${no_cache:-0}"

if [ -n "$delegate_override" ]; then
  delegate=("$delegate_override" "$rustc")
elif [ "$no_cache" != "1" ] && command -v kache >/dev/null 2>&1; then
  delegate=(kache "$rustc")
else
  delegate=("$rustc")
fi

"${delegate[@]}" "${args[@]}"

if [ -z "$out" ] && [ -n "$out_dir" ] && [ -n "$extra_filename" ]; then
  out="$out_dir/$crate_name$extra_filename"
fi

if [ "$crate_type" != "bin" ] || [ "$is_test" -eq 1 ] || [ -z "$out" ] || [ ! -x "$out" ]; then
  exit 0
fi

allowed="${CARGO_BIN_ARTIFACT_ALLOWED_CRATES:-*}"
if [ "$allowed" != "*" ]; then
  allowed_match=0
  IFS=, read -r -a allowed_crates <<<"$allowed"
  for allowed_crate in "${allowed_crates[@]}"; do
    if [ "$crate_name" = "$allowed_crate" ]; then
      allowed_match=1
      break
    fi
  done
  if [ "$allowed_match" -ne 1 ]; then
    exit 0
  fi
fi

case "$out" in
  */deps/"$crate_name"* | */deps/"${crate_name//-/_}"*) ;;
  target/*/deps/"$crate_name"* | target/*/deps/"${crate_name//-/_}"*) ;;
  target/*/*/deps/"$crate_name"* | target/*/*/deps/"${crate_name//-/_}"*) ;;
  *) exit 0 ;;
esac

after_target="${out##*target/}"
profile="unknown"
target_triple=""
IFS=/ read -r first second third _rest <<<"$after_target"
if [ "${second:-}" = "deps" ]; then
  profile="$first"
elif [ "${third:-}" = "deps" ]; then
  target_triple="$first"
  profile="$second"
else
  cache_suffix="${out##*.cache/cargo/}"
  IFS=/ read -r first second third _rest <<<"$cache_suffix"
  if [ "${second:-}" = "deps" ]; then
    profile="$first"
  elif [ "${third:-}" = "deps" ]; then
    target_triple="$first"
    profile="$second"
  fi
fi

case "$profile" in
  release-fast) variant="fast-release" ;;
  *) variant="$profile" ;;
esac

artifact_base="${crate_name//_/-}"
name_map="${CARGO_BIN_ARTIFACT_NAME_MAP:-}"
if [ -n "$name_map" ]; then
  IFS=, read -r -a name_pairs <<<"$name_map"
  for pair in "${name_pairs[@]}"; do
    case "$pair" in
      *=*)
        if [ "$crate_name" = "${pair%%=*}" ]; then
          artifact_base="${pair#*=}"
          break
        fi
        ;;
    esac
  done
fi

ext=""
case "$out" in
  *.exe) ext=".exe" ;;
esac

if [ -n "$target_triple" ]; then
  artifact_name="${artifact_base}-${target_triple}-${variant}${ext}"
else
  artifact_name="${artifact_base}-${variant}${ext}"
fi

warn_install() {
  printf 'cargo-bin-artifact-wrapper: warning: failed to install %s to %s (build unaffected)\n' "$1" "$2" >&2
}

atomic_install() {
  local src="$1"
  local dest="$2"
  local dir base tmp

  dir="$(dirname -- "$dest")"
  base="$(basename -- "$dest")"
  mkdir -p "$dir" || {
    warn_install "$src" "$dest"
    return 0
  }
  tmp="$(mktemp "$dir/.${base}.tmp.XXXXXX" 2>/dev/null)" || {
    warn_install "$src" "$dest"
    return 0
  }
  if cat -- "$src" >"$tmp" && chmod 755 "$tmp" && mv -f "$tmp" "$dest"; then
    return 0
  fi
  rm -f "$tmp"
  warn_install "$src" "$dest"
  return 0
}

bin_dir="${CARGO_BIN_ARTIFACT_DIR:-${CARGO_BIN_ARTIFACT_BIN_DIR:-$repo/bin}}"
if [ "${CARGO_BIN_ARTIFACT_WRITE_BIN_DIR:-1}" != "0" ]; then
  atomic_install "$out" "$bin_dir/$artifact_name"
  if [ "${CARGO_BIN_ARTIFACT_INSTALL_LATEST:-1}" != "0" ]; then
    atomic_install "$out" "$bin_dir/${artifact_base}${ext}"
  fi
fi

local_crate="${CARGO_BIN_ARTIFACT_LOCAL_CRATE:-}"
local_bin="${CARGO_BIN_ARTIFACT_LOCAL_BIN:-$(legacy_value LOCAL_BIN || true)}"
local_profiles="${CARGO_BIN_ARTIFACT_LOCAL_PROFILES:-*}"

if [ -n "$local_crate" ] && [ "$crate_name" = "$local_crate" ] && [ -n "$local_bin" ]; then
  profile_match=0
  if [ "$local_profiles" = "*" ]; then
    profile_match=1
  else
    IFS=, read -r -a profiles <<<"$local_profiles"
    for profile_spec in "${profiles[@]}"; do
      if [ "$profile" = "$profile_spec" ]; then
        profile_match=1
        break
      fi
    done
  fi
  if [ "$profile_match" -eq 1 ]; then
    atomic_install "$out" "$local_bin"
  fi
fi
