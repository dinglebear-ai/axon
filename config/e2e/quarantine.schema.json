{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "quarantines"],
  "properties": {
    "schema": {"const": 1},
    "quarantines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "owner", "rationale", "issue", "tier", "environment", "created_on", "expires_on", "restoration_criteria"],
        "properties": {
          "scenario_id": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "rationale": {"type": "string", "minLength": 12},
          "issue": {"type": "string", "pattern": "^https://"},
          "tier": {"enum": ["hermetic", "live"]},
          "environment": {"type": "string", "minLength": 1},
          "created_on": {"type": "string", "format": "date"},
          "expires_on": {"type": "string", "format": "date"},
          "restoration_criteria": {"type": "string", "minLength": 12}
        }
      }
    }
  }
}
