{
  "dependencies": {
    "lucide-react": "^1.16.0",
    "next": "^16.3.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.0",
    "vitest": "^5.0.0"
  },
  "name": "@axon/admin-panel",
  "description": "Web administration panel for the Axon RAG engine.",
  "author": "dinglebear.ai <hello@dinglebear.ai>",
  "license": "AGPL-3.0-only",
  "homepage": "https://axon.dinglebear.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/dinglebear-ai/axon.git"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.4"
  },
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "lint": "tsc --noEmit",
    "openapi:check": "cd ../.. && cargo xtask check-openapi-drift",
    "openapi:export": "mkdir -p openapi && cargo run --quiet --manifest-path ../../Cargo.toml --bin axon-openapi > openapi/axon.json",
    "openapi:generate": "npm run openapi:export && npm run openapi:types",
    "openapi:types": "node scripts/generate-openapi-types.mjs openapi/axon.json src/api/generated/axon-api.ts",
    "test": "vitest run"
  },
  "version": "7.3.3"
}
